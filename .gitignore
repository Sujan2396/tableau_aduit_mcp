# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Editors
.vscode/
.idea/
*.swp

# OS cruft
.DS_Store
Thumbs.db

# Local test scratch files (real workbooks shouldn't be committed -
# they can contain sensitive business data)
tests/*.twb
tests/*.twbx
!tests/sample.twb
